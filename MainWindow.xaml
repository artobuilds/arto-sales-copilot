<Window x:Class="ArtoSalesCopilot.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArtoSalesCopilot"
 Title="Arto Sales Copilot" Width="1320" Height="900" MinWidth="1000" MinHeight="720"
 Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}" FontFamily="{StaticResource BodyFont}" FontSize="14"
 WindowStartupLocation="CenterScreen" Closing="OnClosing" SizeChanged="WindowSizeChanged" Loaded="SignatureLoaded">
<Grid x:Name="RootLayout" Background="{DynamicResource Bg}">
 <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <TabControl x:Name="Tabs" TabStripPlacement="Left" SelectionChanged="NavigationChanged">
  <TabItem Tag="&#xE8F2;" Header="{DynamicResource L010}" AutomationProperties.Name="{DynamicResource L010}">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal">
      <Button x:Name="LiveButton" AutomationProperties.Name="{DynamicResource L014}" Click="StartLive" Style="{StaticResource Primary}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,9,0"/><TextBlock Text="{DynamicResource L014}"/></StackPanel></Button>
      <Button x:Name="StopButton" Content="{DynamicResource L015}" Click="StopClicked" Style="{StaticResource Quiet}"/>
      <Button x:Name="NewButton" Content="{DynamicResource L016}" Click="NewConversation" Style="{StaticResource Quiet}"/>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal">
      <Button x:Name="DemoButton" Content="{DynamicResource L011}" Click="PlayDemo" Style="{StaticResource Quiet}" ToolTip="{DynamicResource L012}"/>
      <Button Content="{DynamicResource L013}" Click="ExportNotes" Style="{StaticResource Quiet}" Margin="0"/>
     </StackPanel>
    </Grid>
    <ScrollViewer x:Name="CallViewport" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid x:Name="CallLayout" Height="{Binding ActualHeight,ElementName=CallViewport}">
     <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="1.18*"/><ColumnDefinition Width="26"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Border x:Name="AdviceCard" Style="{StaticResource Card}" Background="{DynamicResource AdvicePanel}" BorderBrush="{DynamicResource AdviceBorder}" Padding="28">
      <DockPanel>
       <Grid DockPanel.Dock="Top" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal"><Border x:Name="SignatureMark" Width="3" Height="14" Background="{DynamicResource Metal}" Margin="0,0,9,0"/><TextBlock Text="{DynamicResource L022}" Foreground="{DynamicResource Accent}" FontSize="11" FontWeight="SemiBold"/></StackPanel>
        <TextBlock x:Name="StageText" Grid.Column="1" Text="{DynamicResource L023}" Style="{StaticResource Help}" MaxWidth="150" TextAlignment="Right"/>
       </Grid>
       <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
        <Button x:Name="CopyButton" DockPanel.Dock="Right" Content="{DynamicResource L024}" Click="CopyLine" Padding="12,8" MinHeight="34" FontSize="12" Margin="12,0,0,0"/>
        <TextBlock x:Name="AdviceMeta" Text="{DynamicResource L025}" Style="{StaticResource Help}" VerticalAlignment="Center"/>
       </DockPanel>
       <ScrollViewer x:Name="AdviceScroll" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="AdviceContent">
         <TextBlock x:Name="AdviceTitle" Text="{DynamicResource L026}" FontSize="16" Foreground="{DynamicResource Muted}" Margin="0,0,0,10"/>
         <Border BorderBrush="{DynamicResource Metal}" BorderThickness="2,0,0,0" Padding="18,0,0,0">
          <TextBlock x:Name="SayText" Text="{DynamicResource L027}" FontFamily="{StaticResource DisplayFont}" FontSize="27" LineHeight="37" AutomationProperties.LiveSetting="Polite"/>
         </Border>
        </StackPanel>
       </ScrollViewer>
      </DockPanel>
     </Border>
     <DockPanel Grid.Column="2">
      <DockPanel DockPanel.Dock="Top" Margin="0,4,0,20"><TextBlock x:Name="TurnCount" DockPanel.Dock="Right" Text="{DynamicResource L028}" Style="{StaticResource Help}"/><TextBlock Text="{DynamicResource L029}" FontSize="17" FontWeight="SemiBold"/></DockPanel>
      <ScrollViewer x:Name="TranscriptScroll" VerticalScrollBarVisibility="Auto">
       <StackPanel x:Name="TranscriptPanel"><TextBlock x:Name="EmptyTranscript" Text="{DynamicResource L030}" Style="{StaticResource Help}" Margin="0,16,20,0"/></StackPanel>
      </ScrollViewer>
     </DockPanel>
    </Grid>
        <Border x:Name="VoiceCard" Grid.Row="1" Style="{StaticResource Card}" Margin="0,18,0,0" Padding="0,14,0,0" Background="Transparent" CornerRadius="0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource VoiceBorder}"><StackPanel><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><ComboBox x:Name="VoiceSpeakerBox" Width="140" SelectedIndex="0" SelectionChanged="VoiceSpeakerChanged" AutomationProperties.Name="{DynamicResource L031}" MinHeight="34" Margin="0,0,8,0"><ComboBoxItem x:Name="ClientVoiceItem" Content="{DynamicResource L032}" Tag="client"/><ComboBoxItem x:Name="RepVoiceItem" Content="{DynamicResource L033}" Tag="rep"/></ComboBox><Button x:Name="ResetVoiceButton" Content="{DynamicResource L034}" Click="ResetVoice" IsEnabled="False" FontSize="12" Padding="10,6" MinHeight="34" Margin="0"/></StackPanel><TextBlock x:Name="VoiceHeading" Text="{DynamicResource L035}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TextBlock x:Name="VoiceStatus" Text="{DynamicResource L036}" Style="{StaticResource Help}" Margin="0,7,0,10" AutomationProperties.LiveSetting="Polite"/>
          <UniformGrid Columns="4"><StackPanel Margin="0,0,12,0"><TextBlock x:Name="VoicePitchLabel" Text="{DynamicResource L037}" Style="{StaticResource Help}" ToolTip="{DynamicResource L038}"/><TextBlock x:Name="VoicePitchText" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock x:Name="VoiceLevelLabel" Text="{DynamicResource L039}" Style="{StaticResource Help}" ToolTip="{DynamicResource L040}"/><TextBlock x:Name="VoiceLevelText" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock x:Name="VoicePaceLabel" Text="{DynamicResource L041}" Style="{StaticResource Help}"/><TextBlock x:Name="VoicePaceText" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel><StackPanel><TextBlock x:Name="VoicePauseLabel" Text="{DynamicResource L042}" Style="{StaticResource Help}"/><TextBlock x:Name="VoicePauseText" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></UniformGrid>
          <DockPanel Margin="0,9,0,0"><TextBlock x:Name="VoicePersonText" DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" FontSize="11"/><TextBlock x:Name="VoiceNote" Text="{DynamicResource L043}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,16,0"/></DockPanel>
        </StackPanel></Border>

    <Grid Grid.Row="2" Margin="0,12,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Expander x:Name="CoverageExpander" Header="{DynamicResource L044}" Style="{StaticResource ActionDisclosure}" Margin="0,0,16,0" VerticalAlignment="Top" Expanded="CallDisclosureChanged" Collapsed="CallDisclosureChanged">
      <ScrollViewer MaxHeight="95" VerticalScrollBarVisibility="Auto"><Grid Margin="4,4,4,0">
       <TextBlock x:Name="TopicsEmptyText" Text="{DynamicResource S007}" Style="{StaticResource Help}"/>
       <WrapPanel x:Name="SignalsPanel"/>
      </Grid></ScrollViewer>
     </Expander>
     <Expander x:Name="ManualExpander" Grid.Column="1" Header="{DynamicResource L045}" Style="{StaticResource ActionDisclosure}" VerticalAlignment="Top" Expanded="CallDisclosureChanged" Collapsed="CallDisclosureChanged">
      <DockPanel Margin="0,4,0,0">
       <Button Content="{DynamicResource L046}" Click="SendText" DockPanel.Dock="Right" FontSize="12" Margin="8,0,0,0"/>
       <ComboBox x:Name="SpeakerBox" SelectedIndex="0" Width="95" DockPanel.Dock="Left" Margin="0,0,8,0" AutomationProperties.Name="{DynamicResource L047}"><ComboBoxItem Content="{DynamicResource L048}" Tag="client"/><ComboBoxItem Content="{DynamicResource L049}" Tag="rep"/></ComboBox>
       <TextBox x:Name="ManualText" MaxLength="6000" MaxHeight="80" AutomationProperties.Name="{DynamicResource L050}" ToolTip="{DynamicResource L051}" KeyDown="ManualKeyDown"/>
      </DockPanel>
     </Expander>
    </Grid>

   </Grid>
   </ScrollViewer>
   </Grid>
  </TabItem>
    <TabItem Tag="&#xE8A5;" Header="{DynamicResource L052}" AutomationProperties.Name="{DynamicResource L053}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0"><DockPanel><Button Content="{DynamicResource L054}" Click="SaveBrief" Style="{StaticResource Primary}" DockPanel.Dock="Right" Margin="16,0,0,0"/><TextBlock Text="{DynamicResource L055}" Style="{StaticResource Heading}"/></DockPanel><TextBlock Text="{DynamicResource L056}" Style="{StaticResource Help}" Margin="0,8,0,20"/>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource L057}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource L058}" Style="{StaticResource Label}"/><TextBox x:Name="BriefTitle" MaxLength="300" AutomationProperties.Name="{DynamicResource L059}"/><TextBlock Text="{DynamicResource L060}" Style="{StaticResource Label}"/><TextBox x:Name="ClientText" Height="135" AcceptsReturn="True" MaxLength="24000" AutomationProperties.Name="{DynamicResource L061}"/><TextBlock Text="{DynamicResource L062}" Style="{StaticResource Label}"/><TextBox x:Name="GoalText" Height="72" AcceptsReturn="True" MaxLength="24000" AutomationProperties.Name="{DynamicResource L063}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="{DynamicResource L064}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource L065}" Style="{StaticResource Help}" Margin="0,7,0,0"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource L066}" Style="{StaticResource Label}"/><TextBox x:Name="ProfileText" Height="130" AcceptsReturn="True" MaxLength="24000" AutomationProperties.Name="{DynamicResource L067}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource L068}" Style="{StaticResource Label}"/><TextBox x:Name="OfferText" Height="130" AcceptsReturn="True" MaxLength="24000" AutomationProperties.Name="{DynamicResource L069}"/></StackPanel></Grid><TextBlock Text="{DynamicResource L070}" Style="{StaticResource Label}"/><TextBox x:Name="ConstraintsText" Height="78" AcceptsReturn="True" MaxLength="24000" AutomationProperties.Name="{DynamicResource L071}"/><TextBlock Text="{DynamicResource L072}" Style="{StaticResource Label}"/><TextBox x:Name="CustomText" Height="80" AcceptsReturn="True" MaxLength="4300" AutomationProperties.Name="{DynamicResource L073}"/></StackPanel></Border><WrapPanel Margin="0,16,0,12"><Button Content="{DynamicResource L074}" Click="ImportBrief"/><Button Content="{DynamicResource L075}" Click="ExportBrief"/><Button Content="{DynamicResource L076}" Click="GoAudio"/></WrapPanel>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Tag="&#xE767;" Header="{DynamicResource L077}" AutomationProperties.Name="{DynamicResource L078}">
     <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,8">
      <StackPanel>
       <DockPanel Margin="0,0,0,26">
        <Button Content="{DynamicResource L079}" Click="SaveSettings" Style="{StaticResource Primary}" DockPanel.Dock="Right" Margin="20,0,0,0"/>
        <TextBlock Text="{DynamicResource L081}" Style="{StaticResource Help}" MaxWidth="560" HorizontalAlignment="Left" VerticalAlignment="Center"/>
       </DockPanel>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel>
         <DockPanel Margin="0,0,0,10"><TextBlock Text="01 /" Foreground="{DynamicResource Metal}" FontSize="13" Margin="0,6,14,0" DockPanel.Dock="Left"/><TextBlock Text="{DynamicResource L082}" FontFamily="{StaticResource DisplayFont}" FontSize="23" FontWeight="SemiBold"/></DockPanel>
         <TextBlock Text="{DynamicResource L083}" Style="{StaticResource Label}"/>
         <ComboBox x:Name="MicrophoneBox" AutomationProperties.Name="{DynamicResource L084}"/>
         <TextBlock Text="{DynamicResource L085}" Style="{StaticResource Label}"/>
         <ComboBox x:Name="OutputBox" AutomationProperties.Name="{DynamicResource L086}"/>
         <TextBlock Text="{DynamicResource L087}" Style="{StaticResource Help}" Margin="0,10,0,0"/>
         <Button Content="{DynamicResource L088}" Click="RefreshDevices" Style="{StaticResource Quiet}" HorizontalAlignment="Left" Margin="-10,10,0,0"/>
         <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="0,15,0,0"><StackPanel>
          <CheckBox x:Name="VoiceEnabledBox" Content="{DynamicResource L089}" IsChecked="True"/>
          <TextBlock Text="{DynamicResource L090}" Style="{StaticResource Help}" Margin="42,0,0,0"/>
         </StackPanel></Border>
         <Expander x:Name="CableExpander" Header="{DynamicResource L091}" Margin="0,20,0,0">
          <StackPanel Margin="0,10,0,0"><TextBlock Text="{DynamicResource L092}" Style="{StaticResource Help}"/><TextBlock Text="{DynamicResource L093}" Style="{StaticResource Help}" Margin="0,8,0,0"/><TextBlock Text="{DynamicResource L094}" Foreground="{DynamicResource Warning}" FontSize="13" Margin="0,8,0,0"/></StackPanel>
         </Expander>
        </StackPanel>
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22">
         <StackPanel>
          <DockPanel Margin="0,0,0,12"><TextBlock Text="02 /" Foreground="{DynamicResource Metal}" FontSize="13" Margin="0,6,14,0" DockPanel.Dock="Left"/><TextBlock Text="{DynamicResource L095}" FontFamily="{StaticResource DisplayFont}" FontSize="23" FontWeight="SemiBold"/></DockPanel>
          <CheckBox x:Name="SaveSessionBox" Content="{DynamicResource L096}" IsChecked="True" Margin="0,10,0,8"/>
          <TextBlock Text="{DynamicResource L097}" Style="{StaticResource Help}"/>
          <TextBlock Text="{DynamicResource L098}" Style="{StaticResource Label}"/>
          <ComboBox x:Name="VideoSourceBox" AutomationProperties.Name="{DynamicResource L099}"/>
          <Button Content="{DynamicResource L100}" Click="RefreshVideoSources" HorizontalAlignment="Left" Margin="0,12,0,0"/>
          <TextBlock Text="{DynamicResource L101}" Style="{StaticResource Help}" Margin="0,12,0,0"/>
          <Button Content="{DynamicResource L102}" Click="OpenSessions" Style="{StaticResource Quiet}" HorizontalAlignment="Left" Margin="-10,18,0,0"/>
         </StackPanel>
        </Border>
       </Grid>
       <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,18,0,0" Margin="0,28,0,0">
        <DockPanel><Button Content="{DynamicResource L106}" Click="GoCall" DockPanel.Dock="Right" Margin="20,0,0,0" VerticalAlignment="Bottom"/><StackPanel>
         <CheckBox x:Name="ConsentBox"><TextBlock Text="{DynamicResource L104}"/></CheckBox>
         <TextBlock Text="{DynamicResource L105}" Style="{StaticResource Help}" Margin="42,0,0,0"/>
        </StackPanel></DockPanel>
       </Border>
      </StackPanel>
     </ScrollViewer>
    </TabItem>
    <TabItem Tag="&#xE713;" Header="{DynamicResource L107}" AutomationProperties.Name="{DynamicResource L108}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0"><DockPanel><Button Content="{DynamicResource L079}" Click="SaveSettings" Style="{StaticResource Primary}" DockPanel.Dock="Right" Margin="16,0,0,0"/><TextBlock Text="{DynamicResource S004}" Style="{StaticResource Heading}"/></DockPanel><TextBlock Text="{DynamicResource L110}" Style="{StaticResource Help}" Margin="0,8,0,20"/><Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource E000}" Style="{StaticResource Label}" Margin="0,0,0,8"/><ComboBox x:Name="InterfaceLanguageBox" SelectionChanged="AppearanceChanged" AutomationProperties.Name="{DynamicResource E000}"><ComboBoxItem Content="Русский" Tag="ru"/><ComboBoxItem Content="Українська" Tag="uk"/><ComboBoxItem Content="English" Tag="en"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource E001}" Style="{StaticResource Label}" Margin="0,0,0,8"/><ComboBox x:Name="ThemeBox" SelectionChanged="AppearanceChanged" AutomationProperties.Name="{DynamicResource E001}"><ComboBoxItem Content="{DynamicResource E003}" Tag="dark"/><ComboBoxItem Content="{DynamicResource E002}" Tag="light"/></ComboBox></StackPanel></Grid><TextBlock Text="{DynamicResource E004}" Style="{StaticResource Help}" Margin="0,10,0,0"/></StackPanel></Border>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource L111}" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="KeyStatus" Text="{DynamicResource L112}" Foreground="{DynamicResource Accent}" Margin="0,14,0,8"/><TextBlock Text="{DynamicResource L113}" Style="{StaticResource Help}"/><Expander x:Name="KeysExpander" Header="{DynamicResource L114}" Margin="0,18,0,0"><StackPanel><TextBlock Text="{DynamicResource L115}" Style="{StaticResource Label}"/><PasswordBox x:Name="TypeSafeKey" AutomationProperties.Name="{DynamicResource L116}"/><TextBlock Text="{DynamicResource L117}" Style="{StaticResource Label}"/><PasswordBox x:Name="OpenAiKey" AutomationProperties.Name="{DynamicResource L118}"/><TextBlock Text="{DynamicResource L119}" Style="{StaticResource Help}" Margin="0,10,0,0"/><Button Content="{DynamicResource L120}" Click="ImportTypeSafeKey" HorizontalAlignment="Left" Margin="0,14,0,0"/><Button Content="{DynamicResource L121}" Click="ImportOpenAiKey" HorizontalAlignment="Left" Margin="0,8,0,0"/><Button Content="{DynamicResource L122}" Click="RemoveKeys" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel></Expander></StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource L123}" FontSize="18" FontWeight="SemiBold"/><CheckBox x:Name="PhrasingBox" Content="{DynamicResource L124}" Margin="0,18,0,8"/><TextBlock Text="{DynamicResource L125}" Style="{StaticResource Label}"/><ComboBox x:Name="ModelBox" SelectedIndex="0" AutomationProperties.Name="{DynamicResource L126}"><ComboBoxItem Content="{DynamicResource L127}" Tag="gpt-6-sol"/><ComboBoxItem Content="GPT-5.6 Terra" Tag="gpt-5.6-terra"/><ComboBoxItem Content="GPT-6 Luna" Tag="gpt-6-luna"/></ComboBox><TextBlock Text="{DynamicResource L128}" Style="{StaticResource Label}"/><ComboBox x:Name="ReasoningBox" SelectedIndex="0" AutomationProperties.Name="{DynamicResource L129}"><ComboBoxItem Content="{DynamicResource L130}" Tag="low"/><ComboBoxItem Content="{DynamicResource L131}" Tag="medium"/></ComboBox></StackPanel></Border></Grid>
      <Border Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel><TextBlock Text="{DynamicResource L132}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource L133}" Style="{StaticResource Help}" Margin="0,10,0,0"/></StackPanel></Border>
      <Expander x:Name="AdvancedExpander" Header="{DynamicResource L134}" Margin="0,20,0,12"><StackPanel><TextBlock Text="{DynamicResource L135}" Style="{StaticResource Help}" Margin="0,12,0,10"/><Button x:Name="AiDemoButton" Content="{DynamicResource L136}" Click="PlayAiDemo" HorizontalAlignment="Left"/><TextBlock Text="{DynamicResource L137}" Style="{StaticResource Label}"/><TextBox x:Name="PythonPathText" AutomationProperties.Name="{DynamicResource L138}"/><TextBlock Text="{DynamicResource L139}" Style="{StaticResource Label}"/><TextBox x:Name="CachePathText" AutomationProperties.Name="{DynamicResource L140}"/><TextBlock Text="{DynamicResource L141}" Style="{StaticResource Label}"/><TextBox x:Name="FfmpegText" AutomationProperties.Name="{DynamicResource L142}"/></StackPanel></Expander>
    </StackPanel></ScrollViewer></TabItem>

 </TabControl>
 <DockPanel x:Name="HeaderPanel" VerticalAlignment="Top" Margin="212,24,28,0">
  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
   <CheckBox x:Name="PinBox" Content="{DynamicResource L000}" Checked="PinChanged" Unchecked="PinChanged" Margin="0,0,22,0"/>
   <StackPanel><TextBlock Text="{DynamicResource L001}" Style="{StaticResource Help}" Margin="0,0,0,5"/><ComboBox x:Name="LanguageBox" Width="138" SelectionChanged="LanguageChanged" AutomationProperties.Name="{DynamicResource L002}" ToolTip="{DynamicResource L003}">
    <ComboBoxItem Content="{DynamicResource L004}" Tag="en"/><ComboBoxItem Content="{DynamicResource L005}" Tag="ru"/><ComboBoxItem Content="{DynamicResource L006}" Tag="uk"/>
   </ComboBox></StackPanel>
  </StackPanel>
  <StackPanel Margin="0,0,24,0"><TextBlock x:Name="BrandName" Text="{DynamicResource L010}" Foreground="{DynamicResource Muted}" FontSize="11" FontWeight="SemiBold"/>
   <TextBlock x:Name="PageTitle" Text="{Binding Text,ElementName=BriefTitle}" FontFamily="{StaticResource DisplayFont}" FontSize="27" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Text,ElementName=BriefTitle}"/>
  </StackPanel>
 </DockPanel>
 <Border Grid.Row="1" HorizontalAlignment="Left" Width="184" Background="{DynamicResource Rail}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0"/>
 <Border x:Name="TopStatusBox" Grid.Row="1" Background="{DynamicResource StatusPanel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="212,0,28,16">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock x:Name="ModeText" Text="{DynamicResource L009}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" FontSize="12"/><TextBlock x:Name="StatusText" Text="{DynamicResource L008}" AutomationProperties.LiveSetting="Polite" Style="{StaticResource Help}" Margin="0,4,0,0" MaxHeight="60" TextTrimming="CharacterEllipsis"/></StackPanel>
   <StackPanel Grid.Column="2">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="{DynamicResource L017}" Style="{StaticResource Help}" Margin="0,0,0,5"/><ProgressBar x:Name="MicMeter" Height="3" Maximum="1" Background="{DynamicResource Line}" Foreground="{DynamicResource Accent}" AutomationProperties.Name="{DynamicResource L018}"/></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource L019}" Style="{StaticResource Help}" Margin="0,0,0,5"/><ProgressBar x:Name="OutputMeter" Height="3" Maximum="1" Background="{DynamicResource Line}" Foreground="{DynamicResource AudioAccent}" AutomationProperties.Name="{DynamicResource L020}"/></StackPanel>
    </Grid>
    <TextBlock x:Name="SessionMeta" Text="{DynamicResource L021}" Style="{StaticResource Help}" FontSize="11" LineHeight="16" Margin="0,7,0,0" MaxHeight="32" TextTrimming="CharacterEllipsis"/>
   </StackPanel>
  </Grid>
 </Border>
 <Border x:Name="FeedbackBox" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,92,28,0" Background="{DynamicResource PrimaryFill}" CornerRadius="7" Padding="14,10" IsHitTestVisible="False">
  <TextBlock x:Name="FeedbackText" Foreground="{DynamicResource PrimaryInk}" FontSize="13" AutomationProperties.LiveSetting="Polite"/>
 </Border>
</Grid>
</Window>
